#!/usr/bin/env python3
"""herdr-resource-manager: CPU and memory per herdr workspace, tab and pane, as a popup TUI.

macOS only (`ps` and `sysctl` flags). Python 3.9+ standard library only.
"""

from __future__ import annotations

import collections
import curses
import json
import locale
import os
import socket
import subprocess
import sys
import time
import unicodedata
from dataclasses import dataclass, field
from typing import Callable, Dict, List, NamedTuple, Optional

SAMPLE_INTERVAL = 1.0
STARTUP_GAP = 0.25
TREND_LEN = 120
TREND_MIN_SPAN = 0.05
OUTSIDE_TOP = 3
HOT_CPU = 50.0
SPARK = "▁▂▃▄▅▆▇█"
TITLE = "herdr-resource-manager"
DEFAULT_SOCKET = os.path.expanduser("~/.config/herdr/herdr.sock")


# ---------------------------------------------------------------- herdr socket API


class HerdrError(Exception):
    pass


def herdr_request(method: str, params: Optional[dict] = None) -> dict:
    """One newline-delimited JSON request/response on the herdr API socket."""
    path = os.environ.get("HERDR_SOCKET_PATH") or DEFAULT_SOCKET
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(2.0)
            sock.connect(path)
            line = {"id": "resource-manager", "method": method, "params": params or {}}
            sock.sendall((json.dumps(line) + "\n").encode())
            buf = b""
            while not buf.endswith(b"\n"):
                chunk = sock.recv(65536)
                if not chunk:
                    break
                buf += chunk
    except OSError as e:
        raise HerdrError(f"herdr socket {path}: {e}") from e
    try:
        msg = json.loads(buf)
    except ValueError as e:
        raise HerdrError(f"{method}: unreadable reply") from e
    if "error" in msg:
        err = msg["error"]
        raise HerdrError(f"{method}: {err.get('message', err) if isinstance(err, dict) else err}")
    return msg["result"]


# ---------------------------------------------------------------- processes


class Proc(NamedTuple):
    pid: int
    ppid: int
    cpu: float  # cumulative CPU seconds
    rss: int  # bytes
    comm: str


def parse_cpu_time(text: str) -> float:
    """`ps` time: macOS `MMM:SS.cc` (minutes unbounded); also `[dd-][hh:]mm:ss`."""
    days = 0
    if "-" in text:
        d, text = text.split("-", 1)
        days = int(d)
    seconds = 0.0
    for part in text.split(":"):
        seconds = seconds * 60 + float(part)
    return days * 86400 + seconds


def parse_ps(text: str) -> Dict[int, Proc]:
    procs = {}
    for line in text.splitlines():
        parts = line.split(None, 4)
        if len(parts) < 4:
            continue
        pid, ppid = int(parts[0]), int(parts[1])
        comm = parts[4] if len(parts) == 5 else ""
        procs[pid] = Proc(pid, ppid, parse_cpu_time(parts[2]), int(parts[3]) * 1024, comm)
    return procs


def run_ps(*args: str) -> str:
    # No check: `ps -p` exits 1 when one of the listed pids has exited meanwhile.
    return subprocess.run(["ps", *args], capture_output=True, text=True).stdout


class ProcReader:
    """Whole process table per call. `comm` doubles the cost of `ps -A`, so names are cached
    per pid and looked up only for pids not seen before (they only label "Outside herdr")."""

    def __init__(self, ps: Callable[..., str] = run_ps):
        self.ps = ps
        self.names: Dict[int, str] = {}

    def __call__(self) -> Dict[int, Proc]:
        procs = parse_ps(self.ps("-A", "-o", "pid=,ppid=,time=,rss="))
        new = [str(pid) for pid in procs if pid not in self.names]
        if new:
            for line in self.ps("-o", "pid=,comm=", "-p", ",".join(new)).splitlines():
                parts = line.split(None, 1)
                if len(parts) == 2:
                    self.names[int(parts[0])] = parts[1]
        self.names = {pid: name for pid, name in self.names.items() if pid in procs}
        return {pid: p._replace(comm=self.names.get(pid, "")) for pid, p in procs.items()}


def system_memory() -> int:
    out = subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True, text=True)
    return int(out.stdout.strip() or 0)


def children_map(procs: Dict[int, Proc]) -> Dict[int, List[int]]:
    kids: Dict[int, List[int]] = collections.defaultdict(list)
    for p in procs.values():
        if p.pid != p.ppid:
            kids[p.ppid].append(p.pid)
    return kids


def subtree(root: int, kids: Dict[int, List[int]]) -> List[int]:
    out, stack = [], [root]
    while stack:
        pid = stack.pop()
        out.append(pid)
        stack.extend(kids.get(pid, ()))
    return out


@dataclass
class Usage:
    cpu: Optional[float]  # percent of one core; None = not measured yet
    rss: int

    def __add__(self, other: "Usage") -> "Usage":
        if self.cpu is None and other.cpu is None:
            cpu = None
        else:
            cpu = (self.cpu or 0.0) + (other.cpu or 0.0)
        return Usage(cpu, self.rss + other.rss)


ZERO = Usage(0.0, 0)


def usage_of(pids, procs: Dict[int, Proc], prev_cpu: Optional[Dict[int, float]], dt: Optional[float]) -> Usage:
    """CPU from per-pid deltas (an exited child can't cancel its siblings); RSS summed."""
    rss = sum(procs[p].rss for p in pids if p in procs)
    if prev_cpu is None or not dt:
        return Usage(None, rss)
    busy = sum(max(0.0, procs[p].cpu - prev_cpu.get(p, 0.0)) for p in pids if p in procs)
    return Usage(busy / dt * 100.0, rss)


def app_name(comm: str) -> str:
    """Group helpers under their app: `/Applications/Google Chrome.app/.../Helper` → `Google Chrome`."""
    if ".app/" in comm:
        return os.path.basename(comm.split(".app/", 1)[0])
    return os.path.basename(comm) or "?"


# ---------------------------------------------------------------- tree


@dataclass
class Node:
    id: str
    kind: str  # ws | tab | pane | outside | proc
    label: str
    detail: str = ""
    status: str = ""
    usage: Usage = field(default_factory=lambda: Usage(None, 0))
    children: List["Node"] = field(default_factory=list)
    workspace_id: str = ""
    tab_id: str = ""
    pane_id: str = ""


def pane_display(pane: dict, info: Optional[dict]) -> "tuple[str, str]":
    """(name, detail) for a pane row, e.g. ("claude", "watch #9972") or ("shell", "zsh")."""
    title = pane.get("terminal_title_stripped") or ""
    if not info:
        return pane.get("agent") or pane.get("label") or "pane", title
    fg = info.get("foreground_processes") or []
    pgid = info.get("foreground_process_group_id")
    main = next((p for p in fg if p.get("pid") == pgid), fg[-1] if fg else None)
    if main is None or main.get("pid") == info.get("shell_pid"):
        shell = os.path.basename((main or {}).get("argv0") or "") or "sh"
        return "shell", shell
    argv = main.get("argv") or [main.get("argv0") or "?"]
    name = pane.get("agent") or os.path.basename(argv[0])
    return name, title or " ".join(os.path.basename(a) for a in argv[1:3])


def order_workspaces(workspaces: List[dict]) -> List["tuple[dict, bool]"]:
    """Snapshot order, with linked worktree workspaces right after their primary.

    Returns (workspace, is_linked) pairs; a linked worktree without its primary open stays in place.
    """
    primaries = {}
    for ws in workspaces:
        wt = ws.get("worktree")
        if wt and not wt.get("is_linked_worktree"):
            primaries.setdefault(wt["repo_key"], ws["workspace_id"])
    linked: Dict[str, List[dict]] = collections.defaultdict(list)
    for ws in workspaces:
        wt = ws.get("worktree")
        if wt and wt.get("is_linked_worktree") and wt["repo_key"] in primaries:
            linked[primaries[wt["repo_key"]]].append(ws)
    nested = {w["workspace_id"] for group in linked.values() for w in group}
    out = []
    for ws in workspaces:
        if ws["workspace_id"] in nested:
            continue
        out.append((ws, bool((ws.get("worktree") or {}).get("is_linked_worktree"))))
        out.extend((w, True) for w in linked.get(ws["workspace_id"], ()))
    return out


def build_tree(
    snapshot: dict,
    infos: Dict[str, Optional[dict]],
    procs: Dict[int, Proc],
    prev_cpu: Optional[Dict[int, float]],
    dt: Optional[float],
    own_pid: int,
) -> "tuple[List[Node], Usage]":
    """Top-level nodes (workspaces, then "Outside herdr") and the herdr total."""
    kids = children_map(procs)
    own = set(subtree(own_pid, kids))
    claimed = set(own)

    pane_nodes: Dict[str, Node] = {}
    for pane in snapshot.get("panes", []):
        info = infos.get(pane["pane_id"])
        shell_pid = (info or {}).get("shell_pid")
        pids = subtree(shell_pid, kids) if shell_pid in procs else []
        if own & set(pids):
            continue  # the pane hosting this popup
        pids = [p for p in pids if p not in claimed]
        claimed.update(pids)
        name, detail = pane_display(pane, info)
        status = pane.get("agent_status", "") if pane.get("agent") else ""
        usage = usage_of(pids, procs, prev_cpu, dt) if pids else Usage(None, 0)
        pane_nodes[pane["pane_id"]] = Node(
            pane["pane_id"], "pane", name, detail, status, usage,
            workspace_id=pane["workspace_id"], tab_id=pane["tab_id"], pane_id=pane["pane_id"],
        )

    tabs_by_ws: Dict[str, List[Node]] = collections.defaultdict(list)
    for tab in snapshot.get("tabs", []):
        panes = [n for n in pane_nodes.values() if n.tab_id == tab["tab_id"]]
        if not panes:
            continue
        node = Node(tab["tab_id"], "tab", tab.get("label") or tab["tab_id"], children=panes,
                    workspace_id=tab["workspace_id"], tab_id=tab["tab_id"])
        node.usage = sum((p.usage for p in panes), Usage(None, 0))
        tabs_by_ws[tab["workspace_id"]].append(node)

    nodes: List[Node] = []
    total = Usage(None, 0)
    for ws, is_linked in order_workspaces(snapshot.get("workspaces", [])):
        tabs = tabs_by_ws.get(ws["workspace_id"])
        if not tabs:
            continue
        label = ws.get("label") or ws["workspace_id"]
        node = Node(ws["workspace_id"], "ws", ("↳ " if is_linked else "") + label,
                    children=tabs, workspace_id=ws["workspace_id"])
        node.usage = sum((t.usage for t in tabs), Usage(None, 0))
        total = total + node.usage
        nodes.append(node)

    rest = [p for p in procs if p not in claimed]
    outside = Node("outside", "outside", "Outside herdr", "other apps and daemons",
                   usage=usage_of(rest, procs, prev_cpu, dt))
    by_app: Dict[str, List[int]] = collections.defaultdict(list)
    for pid in rest:
        by_app[app_name(procs[pid].comm)].append(pid)
    apps = [Node("app:" + name, "proc", name, usage=usage_of(pids, procs, prev_cpu, dt))
            for name, pids in by_app.items()]
    apps.sort(key=lambda n: (n.usage.cpu or 0.0, n.usage.rss), reverse=True)
    outside.children = apps[:OUTSIDE_TOP]
    nodes.append(outside)
    return nodes, total


@dataclass
class Row:
    node: Node
    depth: int
    foldable: bool


def flatten(nodes: List[Node], folded: set, depth: int = 0) -> List[Row]:
    rows = []
    for n in nodes:
        rows.append(Row(n, depth, bool(n.children)))
        if n.children and n.id not in folded:
            rows.extend(flatten(n.children, folded, depth + 1))
    return rows


# ---------------------------------------------------------------- formatting


def format_bytes(n: int) -> str:
    if n < 1024 * 1024:
        return f"{n / 1024:.0f} KB"
    if n < 1024 ** 3:
        return f"{n / 1024 ** 2:.1f} MB"
    return f"{n / 1024 ** 3:.2f} GB"


def format_cpu(cpu: Optional[float]) -> str:
    return "…" if cpu is None else f"{cpu:.1f}%"


def sparkline(values, width: int) -> str:
    vals = list(values)[-width:]
    if not vals:
        return ""
    lo, hi = min(vals), max(vals)
    span = max(hi - lo, hi * TREND_MIN_SPAN)  # a wobble under 5% of the peak stays flat
    if span <= 0:
        return SPARK[0] * len(vals)
    return "".join(SPARK[round((v - lo) / span * (len(SPARK) - 1))] for v in vals)


def char_width(ch: str) -> int:
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def text_width(s: str) -> int:
    return sum(char_width(c) for c in s)


def truncate(s: str, width: int) -> str:
    if width <= 0:
        return ""
    if text_width(s) <= width:
        return s
    out, used = "", 0
    for ch in s:
        w = char_width(ch)
        if used + w > width - 1:
            break
        out += ch
        used += w
    return out + "…"


# ---------------------------------------------------------------- sampling


@dataclass
class Frame:
    nodes: List[Node]
    total: Usage


class Sampler:
    def __init__(
        self,
        request: Callable[..., dict] = herdr_request,
        ps: Optional[Callable[[], Dict[int, Proc]]] = None,
        clock: Callable[[], float] = time.monotonic,
        own_pid: Optional[int] = None,
    ):
        self.request, self.clock = request, clock
        self.ps = ps or ProcReader()
        self.own_pid = own_pid if own_pid is not None else os.getpid()
        self.prev_cpu: Optional[Dict[int, float]] = None
        self.prev_t: Optional[float] = None

    def sample(self) -> Frame:
        snapshot = self.request("session.snapshot")["snapshot"]
        infos: Dict[str, Optional[dict]] = {}
        for pane in snapshot.get("panes", []):
            try:
                infos[pane["pane_id"]] = self.request(
                    "pane.process_info", {"pane_id": pane["pane_id"]})["process_info"]
            except HerdrError:
                infos[pane["pane_id"]] = None  # closed between the two calls
        procs = self.ps()
        now = self.clock()
        dt = now - self.prev_t if self.prev_t is not None else None
        nodes, total = build_tree(snapshot, infos, procs, self.prev_cpu, dt, self.own_pid)
        self.prev_cpu = {p.pid: p.cpu for p in procs.values()}
        self.prev_t = now
        return Frame(nodes, total)


# ---------------------------------------------------------------- UI

ESC_ARROWS = {"[A": curses.KEY_UP, "OA": curses.KEY_UP, "[B": curses.KEY_DOWN, "OB": curses.KEY_DOWN}
STATUS_COLOR = {"working": "orange", "blocked": "pink", "idle": "green", "done": "green"}


class App:
    def __init__(self, scr, sampler: Sampler, request: Callable[..., dict] = herdr_request):
        self.scr, self.sampler, self.request = scr, sampler, request
        self.frame: Optional[Frame] = None
        self.folded: set = set()
        self.selected: Optional[str] = None
        self.last_index = 0
        self.scroll = 0
        self.message = ""
        self.confirm: Optional[Node] = None
        self.history: Dict[str, collections.deque] = {}
        self.ram = system_memory()
        self.cores = os.cpu_count() or 1
        self.colors: Dict[str, int] = {}

    # -- setup

    def init_colors(self):
        curses.curs_set(0)
        if not curses.has_colors():
            return
        curses.start_color()
        curses.use_default_colors()
        rich = curses.COLORS >= 256
        palette = {
            "accent": 141 if rich else curses.COLOR_MAGENTA,
            "trend": 115 if rich else curses.COLOR_CYAN,
            "hot": 222 if rich else curses.COLOR_YELLOW,
            "green": 114 if rich else curses.COLOR_GREEN,
            "orange": 215 if rich else curses.COLOR_YELLOW,
            "pink": 211 if rich else curses.COLOR_MAGENTA,
            "grey": 245 if rich else curses.COLOR_WHITE,
            "error": 203 if rich else curses.COLOR_RED,
        }
        for i, (name, color) in enumerate(palette.items(), start=1):
            curses.init_pair(i, color, -1)
            self.colors[name] = curses.color_pair(i)

    def color(self, name: str) -> int:
        return self.colors.get(name, 0)

    # -- data

    def refresh_data(self):
        try:
            self.frame = self.sampler.sample()
        except (HerdrError, OSError) as e:
            self.message = str(e)
            return
        if self.message and not self.confirm:
            self.message = ""
        for n in self.frame.nodes:
            self.history.setdefault(n.id, collections.deque(maxlen=TREND_LEN)).append(n.usage.rss)

    def rows(self) -> List[Row]:
        return flatten(self.frame.nodes, self.folded) if self.frame else []

    def selected_index(self, rows: List[Row]) -> int:
        """Index of the selected row; if it vanished (pane closed), the row now at its old place."""
        for i, r in enumerate(rows):
            if r.node.id == self.selected:
                self.last_index = i
                return i
        return max(0, min(self.last_index, len(rows) - 1))

    # -- drawing

    def put(self, y: int, x: int, text: str, attr: int = 0):
        try:
            self.scr.addstr(y, x, text, attr)
        except curses.error:
            pass  # writing the bottom-right cell raises; the text is drawn anyway

    def put_right(self, y: int, right: int, text: str, attr: int = 0):
        self.put(y, right - text_width(text), text, attr)

    def draw(self):
        scr = self.scr
        scr.erase()
        h, w = scr.getmaxyx()
        if h < 8 or w < 40:
            self.put(0, 0, truncate("Enlarge the popup", w - 1))
            scr.refresh()
            return
        scr.border()
        self.put(0, 2, f" {TITLE} ", self.color("accent") | curses.A_BOLD)
        note = f" CPU 100% = 1 core of {self.cores} "
        self.put_right(0, w - 2, note, self.color("grey"))

        left, right = 2, w - 3
        inner = right - left + 1
        cpu_w, mem_w, gap = 7, 10, 2
        trend_w = min(30, inner // 4) if inner >= 70 else 0
        x_trend = right - trend_w + 1
        x_mem_r = (x_trend - gap - 1) if trend_w else right
        x_cpu_r = x_mem_r - mem_w - gap
        name_w = x_cpu_r - cpu_w - gap - left + 1

        dim = self.color("grey")
        self.put(1, left, "Name", dim)
        self.put_right(1, x_cpu_r + 1, "CPU", dim)
        self.put_right(1, x_mem_r + 1, "Memory", dim)
        if trend_w:
            self.put(1, x_trend, "Memory trend", dim)
        self.put(2, left, "─" * inner, dim)

        list_top, list_bottom = 3, h - 5
        visible = list_bottom - list_top + 1
        rows = self.rows()
        if self.frame is None:
            self.put(list_top, left, self.message or "Sampling…", self.color("error") if self.message else dim)
        sel = self.selected_index(rows)
        if rows:
            self.selected = rows[sel].node.id
        if sel < self.scroll:
            self.scroll = sel
        elif sel >= self.scroll + visible:
            self.scroll = sel - visible + 1
        self.scroll = max(0, min(self.scroll, max(0, len(rows) - visible)))

        for i, row in enumerate(rows[self.scroll:self.scroll + visible]):
            y = list_top + i
            is_sel = self.scroll + i == sel
            self.draw_row(y, left, name_w, x_cpu_r, x_mem_r, x_trend, trend_w, row)
            if is_sel:
                scr.chgat(y, left - 1, inner + 2, curses.A_REVERSE)

        y = h - 4
        self.put(y, left, "─" * inner, dim)
        if self.frame:
            total = self.frame.total
            bold = curses.A_BOLD
            self.put(y + 1, left, "Total in herdr", bold)
            self.put_right(y + 1, x_cpu_r + 1, format_cpu(total.cpu), bold)
            self.put_right(y + 1, x_mem_r + 1, format_bytes(total.rss), bold)
            if trend_w and self.ram:
                share = f"~{total.rss / self.ram * 100:.0f}% of system RAM"
                self.put_right(y + 1, right + 1, truncate(share, trend_w), dim)
        self.draw_footer(h - 2, left, inner)
        scr.refresh()

    def draw_row(self, y, left, name_w, x_cpu_r, x_mem_r, x_trend, trend_w, row: Row):
        n = row.node
        x = left + row.depth * 2
        width = name_w - row.depth * 2
        if row.foldable:
            arrow = "▸ " if n.id in self.folded else "▾ "
            self.put(y, x, arrow, self.color("grey"))
            x, width = x + 2, width - 2
        elif n.kind == "pane":
            dot = self.color(STATUS_COLOR.get(n.status, "grey"))
            self.put(y, x, "● ", dot)
            x, width = x + 2, width - 2
        elif n.kind == "proc":
            self.put(y, x, "· ", self.color("grey"))
            x, width = x + 2, width - 2
        attr = {"ws": self.color("accent") | curses.A_BOLD, "outside": curses.A_BOLD}.get(n.kind, 0)
        label = truncate(n.label, width)
        self.put(y, x, label, attr)
        used = text_width(label)
        if n.detail and width - used > 4:
            self.put(y, x + used + 2, truncate(n.detail, width - used - 2), self.color("grey"))
        cpu = n.usage.cpu
        hot = cpu is not None and cpu >= HOT_CPU
        self.put_right(y, x_cpu_r + 1, format_cpu(cpu), self.color("hot") if hot else 0)
        self.put_right(y, x_mem_r + 1, format_bytes(n.usage.rss))
        if trend_w and row.depth == 0 and n.id in self.history:
            self.put(y, x_trend, sparkline(self.history[n.id], trend_w), self.color("trend"))

    def draw_footer(self, y, left, inner):
        if self.confirm:
            text = f"close {self.confirm.pane_id} ({self.confirm.label})? y/N"
            self.put(y, left, truncate(text, inner), self.color("orange") | curses.A_BOLD)
            return
        if self.message:
            self.put(y, left, truncate(self.message, inner), self.color("error"))
            return
        x = left
        keys = [("↑↓", "move"), ("space", "fold"), ("enter", "focus"), ("x", "close pane"), ("q", "quit")]
        for i, (key, what) in enumerate(keys):
            part = f"{key} {what}" + ("  ·  " if i < len(keys) - 1 else "")
            if x + text_width(part) > left + inner:
                break
            self.put(y, x, key, self.color("accent"))
            self.put(y, x + text_width(key) + 1, part[len(key) + 1:], self.color("grey"))
            x += text_width(part)

    # -- input

    def handle_key(self, key) -> bool:
        """Returns False to quit."""
        rows = self.rows()
        sel = self.selected_index(rows)
        node = rows[sel].node if rows else None
        if self.confirm:
            target, self.confirm = self.confirm, None
            if key in ("y", "Y"):
                self.act("pane.close", {"pane_id": target.pane_id})
                self.refresh_data()
            return True
        if key in ("q", "Q", "\x1b"):
            return False
        if key in (curses.KEY_UP, "k") and rows:
            self.selected = rows[max(0, sel - 1)].node.id
        elif key in (curses.KEY_DOWN, "j") and rows:
            self.selected = rows[min(len(rows) - 1, sel + 1)].node.id
        elif key == curses.KEY_PPAGE and rows:
            self.selected = rows[max(0, sel - 10)].node.id
        elif key == curses.KEY_NPAGE and rows:
            self.selected = rows[min(len(rows) - 1, sel + 10)].node.id
        elif key == " " and node and node.children:
            self.folded ^= {node.id}
        elif key in ("\n", "\r", curses.KEY_ENTER) and node:
            return not self.focus(node)
        elif key in ("x", "X") and node:
            if node.kind == "pane":
                self.confirm = node
            else:
                self.message = "x closes a pane: select a pane row"
        return True

    def act(self, method: str, params: dict) -> bool:
        try:
            self.request(method, params)
            return True
        except HerdrError as e:
            self.message = str(e)
            return False

    def focus(self, node: Node) -> bool:
        """Focus the row's pane / tab / workspace (herdr switches workspace and tab along with it).
        True when done (the popup then closes)."""
        if node.kind == "pane":
            return self.act("pane.focus", {"pane_id": node.pane_id})
        if node.kind == "tab":
            return self.act("tab.focus", {"tab_id": node.tab_id})
        if node.kind == "ws":
            return self.act("workspace.focus", {"workspace_id": node.workspace_id})
        return False

    def read_key(self):
        """One key, or None. curses switches the terminal to application cursor mode and then
        only decodes `ESC O B`; a sender that ignores the mode (e.g. `herdr pane send-keys`) sends
        `ESC [ B`, which would otherwise arrive as a bare Esc and quit."""
        try:
            key = self.scr.get_wch()
        except curses.error:
            return None
        if key != "\x1b":
            return key
        self.scr.nodelay(True)
        seq = ""
        try:
            while len(seq) < 2:
                nxt = self.scr.get_wch()
                if not isinstance(nxt, str):
                    break
                seq += nxt
        except curses.error:
            pass
        finally:
            self.scr.timeout(100)
        if not seq:
            return "\x1b"
        return ESC_ARROWS.get(seq)  # other sequences are ignored, never read as Esc

    def run(self):
        self.init_colors()
        self.scr.timeout(100)
        self.refresh_data()
        time.sleep(STARTUP_GAP)
        self.refresh_data()
        last = time.monotonic()
        while True:
            self.draw()
            key = self.read_key()
            if key is not None and key != curses.KEY_RESIZE and not self.handle_key(key):
                return
            if time.monotonic() - last >= SAMPLE_INTERVAL:
                self.refresh_data()
                last = time.monotonic()


# ---------------------------------------------------------------- entry points


def node_to_dict(n: Node) -> dict:
    out = {"id": n.id, "kind": n.kind, "label": n.label, "detail": n.detail, "status": n.status,
           "cpu": n.usage.cpu, "rss": n.usage.rss}
    if n.children:
        out["children"] = [node_to_dict(c) for c in n.children]
    return out


def main(argv: List[str]) -> int:
    if "--once" in argv:
        sampler = Sampler()
        try:
            sampler.sample()
            time.sleep(0.5)
            frame = sampler.sample()
        except HerdrError as e:
            print(e, file=sys.stderr)
            return 1
        print(json.dumps({"total": {"cpu": frame.total.cpu, "rss": frame.total.rss},
                          "nodes": [node_to_dict(n) for n in frame.nodes]}, indent=1, ensure_ascii=False))
        return 0
    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")
    curses.wrapper(lambda scr: App(scr, Sampler()).run())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
